# Copy this file to .env and fill in the values - env is gitignored and should not be committed. 

# --- serving ---------------------------------------------------------------
# 127.0.0.1 = this machine only. Use 0.0.0.0 so others can reach it.
AIPL_HOST=127.0.0.1
AIPL_PORT=8001

# Only needed while the frontend runs on its own dev server (npm run dev).
AIPL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the built frontend lives. Delete or point elsewhere to disable serving it.
# AIPL_FRONTEND_DIST=/home/aipl/aipl/frontend/dist

# AIPL_DB_PATH=/home/aipl/aipl/backend/data/study.db

# --- study behaviour -------------------------------------------------------
AIPL_GATING=false
AIPL_SESSION_HOURS=12
AIPL_CODE_PREFIX=KVT

# --- the model server ------------------------------------------------------
# The inference engine's OpenAI-compatible endpoint
AIPL_LLM_BASE_URL=http://127.0.0.1:8000/v1
AIPL_LLM_MODEL=
AIPL_LLM_API_KEY=not-needed
AIPL_LLM_TIMEOUT=60